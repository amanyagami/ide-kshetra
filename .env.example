# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# KSHETRA_DATA_MODE: 'mock' (default) plays back demo fixtures for every
# connection/provider endpoint. 'live' fails closed instead: every endpoint
# not yet backed by a real provider integration returns a typed
# PROVIDER_NOT_CONFIGURED error rather than fabricated success.
KSHETRA_DATA_MODE="mock"

# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET: from a Web application
# OAuth client created in Google Cloud Console (APIs & Services > Credentials).
# Redirect URI to register: http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="MY_GOOGLE_OAUTH_CLIENT_SECRET"

# KSHETRA_FIRESTORE_PROJECT_ID: the GCP project holding Kshetra's OWN
# control-plane data (sessions, connection records) — separate from any
# project a user connects as a compute target. Requires a Firestore Native
# database created in that project (`gcloud firestore databases create`)
# and Application Default Credentials available to the server
# (`gcloud auth application-default login` for local dev).
KSHETRA_FIRESTORE_PROJECT_ID="MY_FIRESTORE_PROJECT_ID"

# KSHETRA_SESSION_SECRET: random secret used to sign OAuth CSRF state tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KSHETRA_SESSION_SECRET="MY_RANDOM_SESSION_SECRET"

# GitHub App (github.com/settings/apps/new). Needs Contents:Read + Metadata:Read
# repository permissions. GITHUB_APP_SLUG is the app's URL slug (from its
# settings page URL); GITHUB_APP_PRIVATE_KEY is the downloaded .pem contents
# with real newlines replaced by literal \n so it fits on one env line.
GITHUB_APP_ID="MY_GITHUB_APP_ID"
GITHUB_APP_SLUG="MY_GITHUB_APP_SLUG"
GITHUB_APP_PRIVATE_KEY="MY_GITHUB_APP_PRIVATE_KEY"
GITHUB_APP_CLIENT_ID="MY_GITHUB_APP_CLIENT_ID"
GITHUB_APP_CLIENT_SECRET="MY_GITHUB_APP_CLIENT_SECRET"
